{
  "id": "cafe",
  "display_name": "ApexVoid Café & Photo Booth",
  "description": "Independent café counter and photo-booth booking application",
  "version": "0.1.0",
  "api_contract_version": "v1",
  "service_identity": "cafe",
  "service_endpoint": "http://cafe:8090",
  "health_endpoint": "http://cafe:8090/health",
  "frontend_route": "/apps/cafe",
  "access_match": "any",
  "access_permissions": ["cafe.catalog.read", "cafe.order.read", "cafe.booking.read"],
  "permissions": [
    {"name":"cafe.catalog.read","display_name":"View Café Menu","scope":"workspace"},
    {"name":"cafe.catalog.manage","display_name":"Manage Café Menu","scope":"workspace"},
    {"name":"cafe.order.read","display_name":"View Café Orders","scope":"workspace"},
    {"name":"cafe.order.manage","display_name":"Take and Fulfill Café Orders","scope":"workspace"},
    {"name":"cafe.booking.read","display_name":"View Photo Booth Bookings","scope":"workspace"},
    {"name":"cafe.booking.manage","display_name":"Manage Photo Booth Sessions","scope":"workspace"},
    {"name":"cafe.booth.manage","display_name":"Configure Photo Booths","scope":"workspace"}
  ]
}
