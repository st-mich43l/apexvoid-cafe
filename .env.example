# Copy to .env and change before starting containers.
# These are non-secret connection coordinates for the existing Enterprise
# PostgreSQL service. Enterprise supplies database/name/role/password at enroll.
APEXVOID_URL=http://backend:6868
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_SSLMODE=disable
SERVICE_URL=http://cafe:8090
APEXVOID_APPS_NETWORK=apexvoid-apps
APEXVOID_DATA_NETWORK=apexvoid-data
